@@ -0,0 +1,160 @@
+"""The data specification is always the bundled original workbook, whatever the form."""
+
+from __future__ import annotations
+
+import csv
+from importlib.resources import files
+from pathlib import Path
+
+import pytest
+from PySide6.QtWidgets import QDialog, QLabel
+
+import investigator.storage as storage
+from investigator.form_definition import FormDefinition, field_record, new_field
+from investigator.main_window import MainWindow
+from investigator.models import InvestigationCase
+from investigator.project_tabs_state import ProjectTabsStore
+from investigator.schema import Choice, FieldKind, FieldSpec
+from investigator.speed_csv import speed_csv_path
+from investigator.storage import (
+    DATA_SPECIFICATION_FILENAME,
+    CaseRepository,
+    WorkspaceError,
+    data_specification_path,
+)
+from investigator.widgets.csv_export_dialog import CsvExportDialog
+
+ORIGINAL = files("investigator").joinpath("assets", DATA_SPECIFICATION_FILENAME).read_bytes()
+
+
+def tab_for(definition: FormDefinition, key: str) -> dict:
+    return next(tab for tab in definition.tabs if tab["key"] == key)
+
+
+def edit_form(definition: FormDefinition) -> None:
+    """Reorder, add and rename items the way the form designer can."""
+    driver = tab_for(definition, "driver")
+    driver["fields"].reverse()
+    driver["fields"].insert(1, field_record(FieldSpec(
+        "custom_flags", "추가 확인 항목", FieldKind.MULTI, "custom_flags",
+        (Choice("자료 확인", "documents", "custom_documents"),
+         Choice("현장 확인", "scene", "custom_scene")),
+    )))
+    evidence = tab_for(definition, "evidence")
+    definition.tabs.remove(evidence)
+    definition.tabs.insert(1, evidence)
+    remarks = next(record for record in definition.records() if record["key"] == "remarks")
+    remarks.update(label="현장 추가 의견", csv_column="current_notes", aliases=["remarks"])
+    definition.validate()
+
+
+def csv_headers(path: Path) -> list[str]:
+    with path.open(encoding="utf-8-sig", newline="") as handle:
+        return next(csv.reader(handle))
+
+
+def test_default_form_exports_the_bundled_workbook_unchanged(tmp_path):
+    destination = CaseRepository(tmp_path).export_csv(
+        tmp_path / "default.csv", [], include_specification=True,
+    )
+    assert data_specification_path(destination).read_bytes() == ORIGINAL
+
+
+def test_form_edits_change_the_csv_but_never_the_specification(tmp_path):
+    repository = CaseRepository(tmp_path)
+    edit_form(repository.form_definition)
+    destination = repository.export_csv(tmp_path / "edited.csv", [], include_specification=True)
+    headers = csv_headers(destination)
+    assert {"custom_flags", "custom_documents", "custom_scene", "current_notes"} <= set(headers)
+    assert "remarks" not in headers
+    assert data_specification_path(destination).read_bytes() == ORIGINAL
+
+
+def test_form_saved_in_project_still_exports_the_original_after_restart(tmp_path):
+    repository = CaseRepository(tmp_path)
+    definition = repository.form_definition
+    edit_form(definition)
+    case = InvestigationCase(values={
+        "institution": "samsung", "accident_classification": "2020011300001",
+    })
+    repository.save([case], form_definition=definition)
+    reopened = CaseRepository(tmp_path)
+    destination = reopened.export_csv(
+        tmp_path / "reopened.csv", reopened.load(), include_specification=True,
+    )
+    assert "current_notes" in csv_headers(destination)
+    assert data_specification_path(destination).read_bytes() == ORIGINAL
+
+
+def test_reexport_replaces_an_earlier_workbook_with_the_original(tmp_path):
+    destination = tmp_path / "result.csv"
+    data_specification_path(destination).write_bytes(b"workbook generated by an older build")
+    CaseRepository(tmp_path).export_csv(destination, [], include_specification=True)
+    assert data_specification_path(destination).read_bytes() == ORIGINAL
+
+
+def test_omitting_the_specification_does_not_read_or_touch_it(tmp_path, monkeypatch):
+    def not_used(*_args, **_kwargs):
+        raise AssertionError("The disabled specification must not be read")
+
+    monkeypatch.setattr(storage, "files", not_used)
+    destination = tmp_path / "without.csv"
+    previous = data_specification_path(destination)
+    previous.write_bytes(b"previous workbook")
+    CaseRepository(tmp_path).export_csv(destination, [], include_specification=False)
+    assert previous.read_bytes() == b"previous workbook"
+    assert destination.exists()
+    assert speed_csv_path(destination).exists()
+
+
+def test_unreadable_original_preserves_every_previous_export(tmp_path, monkeypatch):
+    destination = tmp_path / "result.csv"
+    outputs = {
+        destination: b"previous investigation",
+        speed_csv_path(destination): b"previous speed",
+        data_specification_path(destination): b"previous workbook",
+    }
+    for path, content in outputs.items():
+        path.write_bytes(content)
+
+    def missing(*_args, **_kwargs):
+        raise FileNotFoundError("bundled specification is missing")
+
+    monkeypatch.setattr(storage, "files", missing)
+    with pytest.raises(WorkspaceError, match="데이터 명세서"):
+        CaseRepository(tmp_path).export_csv(destination, [], include_specification=True)
+    assert {path: path.read_bytes() for path in outputs} == outputs
+    assert not list(tmp_path.glob("*.tmp"))
+
+
+def test_export_option_names_the_original_workbook(qtbot, tmp_path):
+    dialog = CsvExportDialog(tmp_path / "result.csv")
+    qtbot.addWidget(dialog)
+    assert dialog.include_specification.text() == "데이터 명세서(원본)도 함께 내보내기"
+    assert dialog.include_specification.isChecked()
+    detail = dialog.findChild(QLabel, "dataSpecificationExportDetail")
+    assert detail is not None
+    assert "result_데이터명세서.xlsx" in detail.text()
+    assert "원본 명세서를 그대로" in detail.text()
+    assert "명세서는 바뀌지 않습니다" in detail.text()
+
+
+def test_main_window_exports_the_original_after_a_form_edit(qtbot, tmp_path, monkeypatch):
+    # A private tab store keeps this test out of the user's real project tabs.
+    window = MainWindow(
+        tmp_path / "project", project_tabs_store=ProjectTabsStore(tmp_path / "tabs.json"),
+    )
+    qtbot.addWidget(window)
+    definition = window.repository.form_definition
+    definition.tabs[-1]["fields"].append(new_field())
+    definition.validate()
+    destination = tmp_path / "result.csv"
+    monkeypatch.setattr(window, "_save", lambda **_kwargs: True)
+    monkeypatch.setattr(
+        "investigator.main_window.QFileDialog.getSaveFileName",
+        lambda *_args: (str(destination), "CSV 파일 (*.csv)"),
+    )
+    monkeypatch.setattr(CsvExportDialog, "exec", lambda _dialog: QDialog.DialogCode.Accepted)
+    window.export_csv()
+    assert data_specification_path(destination).read_bytes() == ORIGINAL
+    window.close()
