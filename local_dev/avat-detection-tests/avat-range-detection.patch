@@ -0,0 +1,120 @@
+"""마스크 → 박스·폴리곤 변환과 중복 제거."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+
+import cv2
+import numpy as np
+
+from .backend import RawInstance
+from .classes import ClassConfig, ClassDef
+
+
+@dataclass
+class Detection:
+    class_key: str
+    prompt: str
+    score: float
+    bbox_xywh: tuple[float, float, float, float]
+    mask: np.ndarray | None = field(default=None, repr=False)
+    polygon: list[list[float]] = field(default_factory=list)
+    area: int = 0
+
+
+def mask_to_bbox(mask: np.ndarray) -> tuple[float, float, float, float] | None:
+    ys, xs = np.nonzero(mask)
+    if xs.size == 0:
+        return None
+    x0, x1 = int(xs.min()), int(xs.max()) + 1
+    y0, y1 = int(ys.min()), int(ys.max()) + 1
+    return float(x0), float(y0), float(x1 - x0), float(y1 - y0)
+
+
+def mask_to_polygon(mask: np.ndarray, max_points: int = 64) -> list[list[float]]:
+    """가장 큰 외곽선을 단순화한 폴리곤. 나중에 폴리곤 주석으로 쓸 수 있게 보존한다."""
+    contours, _ = cv2.findContours(
+        mask.astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
+    )
+    if not contours:
+        return []
+    contour = max(contours, key=cv2.contourArea)
+    eps = 0.005 * cv2.arcLength(contour, True)
+    approx = cv2.approxPolyDP(contour, eps, True)
+    while len(approx) > max_points:
+        eps *= 1.5
+        approx = cv2.approxPolyDP(contour, eps, True)
+    return [[float(p[0][0]), float(p[0][1])] for p in approx]
+
+
+def mask_iou(a: np.ndarray, b: np.ndarray) -> float:
+    inter = np.logical_and(a, b).sum()
+    if inter == 0:
+        return 0.0
+    union = np.logical_or(a, b).sum()
+    return float(inter) / float(union)
+
+
+def box_iou(a: tuple[float, ...], b: tuple[float, ...]) -> float:
+    ax, ay, aw, ah = a
+    bx, by, bw, bh = b
+    ix = max(0.0, min(ax + aw, bx + bw) - max(ax, bx))
+    iy = max(0.0, min(ay + ah, by + bh) - max(ay, by))
+    inter = ix * iy
+    union = aw * ah + bw * bh - inter
+    return inter / union if union > 0 else 0.0
+
+
+def _nms(dets: list[Detection], iou_thr: float) -> list[Detection]:
+    kept: list[Detection] = []
+    for det in sorted(dets, key=lambda d: d.score, reverse=True):
+        if all(mask_iou(det.mask, k.mask) <= iou_thr for k in kept):
+            kept.append(det)
+    return kept
+
+
+def build_detections(
+    raw: dict[str, list[RawInstance]],
+    classes: tuple[ClassDef, ...],
+    config: ClassConfig,
+    frame_shape: tuple[int, int],
+) -> list[Detection]:
+    """프롬프트별 원시 결과를 클래스 단위 검출로 정리한다."""
+    h, w = frame_shape
+    frame_area = float(h * w)
+    per_class: dict[str, list[Detection]] = {}
+    for cls in classes:
+        dets: list[Detection] = []
+        for prompt in cls.prompts:
+            instances = sorted(raw.get(prompt, []), key=lambda r: r.score, reverse=True)
+            for inst in instances[: config.max_detections_per_prompt]:
+                if inst.score < cls.threshold:
+                    continue
+                mask = inst.mask.astype(bool)
+                area = int(mask.sum())
+                if area < cls.min_area_ratio * frame_area:
+                    continue
+                bbox = mask_to_bbox(mask)
+                if bbox is None:
+                    continue
+                dets.append(Detection(cls.key, prompt, inst.score, bbox, mask, area=area))
+        per_class[cls.key] = _nms(dets, config.same_class_iou)
+
+    # 같은 suppression_group 안에서는 같은 영역을 두 클래스가 동시에 갖지 않게 한다.
+    groups: dict[str, list[Detection]] = {}
+    for cls in classes:
+        if cls.suppression_group:
+            groups.setdefault(cls.suppression_group, []).extend(per_class[cls.key])
+    suppressed: set[int] = set()
+    for members in groups.values():
+        survivors = _nms(members, config.cross_class_iou)
+        suppressed.update(id(d) for d in members if all(d is not s for s in survivors))
+
+    out: list[Detection] = []
+    for cls in classes:
+        for det in per_class[cls.key]:
+            if id(det) in suppressed:
+                continue
+            det.polygon = mask_to_polygon(det.mask)
+            out.append(det)
+    return out
diff --git a/investigator/detection_worker/runner.py b/investigator/detection_worker/runner.py
new file mode 100644
index 0000000..4d99155
--- /dev/null
+++ b/investigator/detection_worker/runner.py
@@ -0,0 +1,209 @@
+"""영상 전체를 샘플링해 SAM 3로 검출하고 결과 문서를 만든다."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import tempfile
+from dataclasses import dataclass
+from datetime import UTC, datetime
+from pathlib import Path
+
+import cv2
+
+from . import RESULT_SCHEMA_VERSION, WORKER_NAME, WORKER_VERSION
+from .backend import PromptBackend
+from .classes import ClassConfig, ClassDef
+from .events import CancelToken, EventWriter
+from .postprocess import build_detections
+from .tracking import SimpleTracker
+
+
+class Cancelled(Exception):
+    pass
+
+
+@dataclass
+class RunOptions:
+    video_path: Path
+    output_path: Path
+    sample_fps: float = 2.0
+    frame_step: int | None = None  # 지정하면 sample_fps 대신 N프레임 간격
+    start_frame: int = 0
+    end_frame: int | None = None  # 포함하지 않음
+    mask_threshold: float = 0.5
+    include_polygons: bool = True
+
+
+def plan_frames(frame_count: int, video_fps: float, opts: RunOptions) -> list[int]:
+    """처리할 프레임 번호 목록. frame_step 또는 sample_fps로 간격을 정한다."""
+    if frame_count <= 0:
+        raise ValueError("영상 프레임 수를 확인할 수 없습니다.")
+    start = max(0, opts.start_frame)
+    end = frame_count if opts.end_frame is None else min(frame_count, opts.end_frame)
+    if start >= end:
+        raise ValueError(f"처리 구간이 비었습니다: start={start}, end={end}")
+    fps = video_fps if video_fps and video_fps > 0 else 30.0
+    if opts.frame_step is not None:
+        step = max(1, int(opts.frame_step))
+    else:
+        step = max(1, round(fps / opts.sample_fps)) if opts.sample_fps > 0 else 1
+    return list(range(start, end, step))
+
+
+def run(
+    opts: RunOptions,
+    backend: PromptBackend,
+    config: ClassConfig,
+    classes: tuple[ClassDef, ...],
+    events: EventWriter,
+    cancel: CancelToken,
+    device_note: str | None = None,
+) -> dict:
+    cap = cv2.VideoCapture(str(opts.video_path))
+    if not cap.isOpened():
+        raise RuntimeError(f"영상을 열 수 없습니다: {opts.video_path}")
+    try:
+        frame_count = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
+        video_fps = float(cap.get(cv2.CAP_PROP_FPS)) or 30.0
+        width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
+        height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
+        frames = plan_frames(frame_count, video_fps, opts)
+        prompts = sorted({p for c in classes for p in c.prompts})
+        # 백엔드 단계의 점수 문턱값은 클래스별 문턱값 중 최솟값으로 넓게 잡는다.
+        backend_threshold = min(c.threshold for c in classes)
+
+        events.emit(
+            "started",
+            device=backend.device,
+            device_note=device_note,
+            total_frames=len(frames),
+            video_frame_count=frame_count,
+            video_fps=video_fps,
+            classes=[c.key for c in classes],
+            prompts=prompts,
+        )
+
+        tracker = SimpleTracker()
+        prefix_counters: dict[str, int] = {}
+        object_ids: dict[int, str] = {}
+        records: list[dict] = []
+        class_by_key = {c.key: c for c in classes}
+
+        next_sequential = 0
+        for sample_index, frame_index in enumerate(frames):
+            if cancel.cancelled:
+                raise Cancelled()
+            # 간격이 촘촘하면 순차 읽기가 seek보다 빠르고 정확하다.
+            if frame_index != next_sequential:
+                cap.set(cv2.CAP_PROP_POS_FRAMES, frame_index)
+            ok, frame_bgr = cap.read()
+            next_sequential = frame_index + 1
+            if not ok:
+                events.emit(
+                    "warning", message="프레임을 읽지 못해 건너뜁니다.", frame_index=frame_index
+                )
+                continue
+            frame_rgb = cv2.cvtColor(frame_bgr, cv2.COLOR_BGR2RGB)
+            raw = backend.predict(frame_rgb, prompts, backend_threshold, opts.mask_threshold)
+            dets = build_detections(raw, classes, config, frame_rgb.shape[:2])
+            track_ids = tracker.update(sample_index, [(d.class_key, d.bbox_xywh) for d in dets])
+
+            for det, tid in zip(dets, track_ids, strict=True):
+                if tid not in object_ids:
+                    prefix = class_by_key[det.class_key].object_prefix
+                    prefix_counters[prefix] = prefix_counters.get(prefix, 0) + 1
+                    object_ids[tid] = f"{prefix}{prefix_counters[prefix]:03d}"
+                record = {
+                    "frame_index": frame_index,
+                    "timestamp_ms": round(frame_index / video_fps * 1000.0, 1),
+                    "class_key": det.class_key,
+                    "class_label": class_by_key[det.class_key].label,
+                    "bbox_xywh": [round(v, 1) for v in det.bbox_xywh],
+                    "score": round(det.score, 4),
+                    "track_id": tid,
+                    "object_id": object_ids[tid],
+                    "metadata": {
+                        "prompt": det.prompt,
+                        "mask_area_px": det.area,
+                    },
+                }
+                if opts.include_polygons and det.polygon:
+                    record["metadata"]["polygon"] = [
+                        [round(x, 1), round(y, 1)] for x, y in det.polygon
+                    ]
+                records.append(record)
+
+            events.emit(
+                "progress",
+                processed=sample_index + 1,
+                total=len(frames),
+                frame_index=frame_index,
+                detections_in_frame=len(dets),
+            )
+    finally:
+        cap.release()
+
+    return {
+        "schema_version": RESULT_SCHEMA_VERSION,
+        "created_at": datetime.now(UTC).isoformat(timespec="seconds"),
+        "provenance": {
+            "source": "automatic_detection",
+            "detector": WORKER_NAME,
+            "detector_version": WORKER_VERSION,
+            "model_id": backend.model_id,
+            "device": backend.device,
+            "tracker": "simple_iou_center_v1",
+            "review_status": "unreviewed",
+        },
+        "video": {
+            "path": str(opts.video_path),
+            "sha256": _sha256(opts.video_path),
+            "frame_count": frame_count,
+            "fps": video_fps,
+            "width": width,
+            "height": height,
+        },
+        "sampling": {
+            "sample_fps": opts.sample_fps,
+            "frame_step": opts.frame_step,
+            "processed_frames": frames,
+            "start_frame": frames[0],
+            "end_frame_exclusive": opts.end_frame if opts.end_frame is not None else frame_count,
+        },
+        "classes": [
+            {
+                "key": c.key,
+                "label": c.label,
+                "prompts": list(c.prompts),
+                "threshold": c.threshold,
+                "object_prefix": c.object_prefix,
+            }
+            for c in classes
+        ],
+        "detections": records,
+    }
+
+
+def _sha256(path: Path) -> str:
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(1 << 20), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def write_atomic(doc: dict, path: Path) -> None:
+    """임시 파일에 쓰고 fsync 후 교체한다. 중간에 실패하면 기존 파일은 그대로다."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", suffix=".tmp", dir=path.parent)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as f:
+            json.dump(doc, f, ensure_ascii=False, indent=1)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(tmp, path)
+    except BaseException:
+        Path(tmp).unlink(missing_ok=True)
+        raise
