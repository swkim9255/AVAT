+@dataclass(frozen=True, slots=True)
+class DetectionClass:
+    key: str
+    label: str
+    group: str
+    prompts: tuple[str, ...]
+    object_prefix: str
+    trigger: LabelRef | None
+    collision: LabelRef | None
+    threshold: float = 0.4
+    suppression_group: str | None = None
+    min_area_ratio: float = 0.0005
+
+
+def _t(field_key: str, choice_id: str) -> LabelRef:
+    return LabelRef(field_key, choice_id)
+
+
+def _c(choice_id: str) -> LabelRef:
+    return LabelRef(COLLISION_TARGET_FIELD, choice_id)
