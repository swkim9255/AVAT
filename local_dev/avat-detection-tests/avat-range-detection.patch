diff --git a/investigator/object_detection.py b/investigator/object_detection.py
new file mode 100644
index 0000000..8250a7e
--- /dev/null
+++ b/investigator/object_detection.py
@@ -0,0 +1,985 @@
+"""Object detection classes, role-dependent labels, and per-video object storage.
+
+Detection classes are the union of the '객체' (trigger objects) and '충돌'
+(collision targets) choices. A detected object is always labelled through the
+current workspace form definition: as a trigger-time obstacle choice or as a
+collision target choice, depending on its role. Labels keep the stable choice
+``id`` so renaming a choice in the form designer does not break saved objects.
+
+This module has no Qt dependency.
+"""
+
+from __future__ import annotations
+
+import math
+from collections.abc import Iterable
+from dataclasses import dataclass, field
+from datetime import UTC, datetime
+from typing import TYPE_CHECKING, Any
+from uuid import uuid4
+
+if TYPE_CHECKING:
+    from investigator.form_definition import FormDefinition
+
+ROLE_TRIGGER = "trigger"
+ROLE_COLLISION = "collision"
+ROLES = (ROLE_TRIGGER, ROLE_COLLISION)
+ROLE_TITLES = {ROLE_TRIGGER: "트리거 시점 관여 객체", ROLE_COLLISION: "충돌 관여 객체"}
+ROLE_SHORT = {ROLE_TRIGGER: "트리거", ROLE_COLLISION: "충돌"}
+
+SOURCE_AUTOMATIC = "automatic_detection"
+SOURCE_MANUAL = "manual"
+
+TRIGGER_TAB = "trigger_objects"
+COLLISION_TAB = "collision_objects"
+TRIGGER_OBJECT_FIELDS = (
+    "obstacle_vehicle_types",
+    "obstacle_pedestrians",
+    "obstacle_road_facilities",
+    "obstacle_building_landscape",
+    "obstacle_other",
+)
+COLLISION_TARGET_FIELD = "collision_targets"
+OBSTACLE_EXISTS_FIELD = "obstacle_exists"
+UNLABELED_TEXT = "라벨 미지정"
+
+
+@dataclass(frozen=True, slots=True)
+class LabelRef:
+    """A form choice identified by its field key and stable choice id."""
+
+    field_key: str
+    choice_id: str
+
+    def to_dict(self) -> dict[str, str]:
+        return {"field": self.field_key, "choice": self.choice_id}
+
+    @classmethod
+    def from_dict(cls, raw: Any) -> LabelRef | None:
+        if raw is None:
+            return None
+        if (
+            not isinstance(raw, dict)
+            or not isinstance(raw.get("field"), str)
+            or not isinstance(raw.get("choice"), str)
+        ):
+            raise TypeError("객체 라벨 형식이 올바르지 않습니다.")
+        return cls(raw["field"], raw["choice"])
+
