+def _lower_process_priority() -> None:
+    """검출 프로세스를 '보통 미만' 우선순위로 낮춘다.
+
+    CPU 추론과 디코딩이 모든 코어를 오래 쓰더라도 AVAT 화면·오디오·시스템 서비스가
