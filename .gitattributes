# Default to LF for detected text, regardless of local core.autocrlf settings.
* text=auto eol=lf

# Application, test, development-tool, and mockup source code.
*.py text eol=lf
*.pyi text eol=lf
*.pyw text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.sql text eol=lf

# Repository configuration, portable settings, and documentation.
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.ndjson text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.patch text eol=lf
*.codepoints text eol=lf
LICENSE* text eol=lf
NOTICE* text eol=lf

# Windows batch launchers use CRLF in the working tree (LF in Git).
*.cmd text eol=crlf
*.bat text eol=crlf

# Bundled fonts, images, and Office templates: never normalize binary bytes.
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.xlsx binary
*.xls binary
*.docx binary
*.doc binary
*.pdf binary

# These artifacts remain excluded by .gitignore; binary is not an ignore rule.
*.mp4 binary
*.mov binary
*.avi binary
*.mkv binary
*.webm binary
*.db binary
*.db-wal binary
*.db-shm binary
*.db-journal binary
*.pt binary
*.pth binary
*.ckpt binary
*.safetensors binary
*.onnx binary
*.engine binary
*.bin binary
*.npy binary
*.npz binary
*.pkl binary
*.pickle binary

# TorchScript model files are not TypeScript source.
/runtime/models/**/*.ts binary
